{
  "name": "@zi3t/volume-catalogue",
  "version": "0.1.0",
  "private": true,
  "description": "Portable Three.js volume catalogue extracted from zi3t.io/press.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zi3t/volume-catalogue.git"
  },
  "homepage": "https://github.com/zi3t/volume-catalogue#readme",
  "bugs": {
    "url": "https://github.com/zi3t/volume-catalogue/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./site-entry": "./dist/site-entry.js",
    "./cloudflare-worker": "./dist/cloudflare-worker.js",
    "./styles": "./dist/volume-catalogue.css",
    "./volume-styles": "./dist/volume-catalogue-volumes.css"
  },
  "files": [
    "dist",
    "docs",
    "src",
    "tests",
    "README.md"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "build": "vite build && node scripts/copy-volume-styles.mjs",
    "build:site": "npm run build && node scripts/sync-site.mjs",
    "check": "npm run typecheck && npm run build",
    "profile": "deno run --allow-net --allow-read --allow-write tests/profile-press-scene.mjs",
    "record:first-load": "deno run --allow-net --allow-read --allow-write --allow-run=ffmpeg tests/record-press-first-load.mjs",
    "capture:reference": "deno run --allow-net --allow-read --allow-write tests/capture-reference.mjs",
    "capture:glframe": "deno run --allow-net --allow-read --allow-write tests/capture-glframe.mjs"
  },
  "dependencies": {
    "three": "0.171.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260731.1",
    "@types/node": "26.1.2",
    "@types/three": "0.171.0",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "wrangler": "4.116.0"
  }
}
